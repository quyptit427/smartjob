NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
GATEWAY_PORT=3000
USER_PORT=3001
JOB_PORT=3002
APPLICATION_PORT=3003
RECOMMENDATION_PORT=3004
RESUME_PORT=3005
AI_PORT=3006
AI_TIMEOUT_MS=180000
USER_SERVICE_URL=http://127.0.0.1:3001
JOB_SERVICE_URL=http://127.0.0.1:3002
APPLICATION_SERVICE_URL=http://127.0.0.1:3003
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:3004
RESUME_SERVICE_URL=http://127.0.0.1:3005
AI_SERVICE_URL=http://127.0.0.1:3006
OPENAI_API_BASE_URL=https://api.xingchiapi.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MONGODB_URI=mongodb://127.0.0.1:27017
USER_DB=smartjob_users
JOB_DB=smartjob_jobs
APPLICATION_DB=smartjob_applications
RESUME_DB=smartjob_resumes
# npm run setup generates secure local values for these two secrets.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
JWT_EXPIRES_IN=8h
HTTP_TIMEOUT_MS=5000
GATEWAY_TIMEOUT_MS=10000
VITE_API_URL=http://localhost:3000/api
# Production on Render. Leave unset for local disk CV files and in-process RAG.
# RESUME_STORAGE=gridfs
# AI_DB=smartjob_ai
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# VECTORIZE_INDEX=smartjob-jobs
# Demo credentials are required only by npm run seed. Change before sharing.
DEMO_CANDIDATE_EMAIL=candidate@smartjob.local
DEMO_RECRUITER_EMAIL=recruiter@smartjob.local
DEMO_PASSWORD=
